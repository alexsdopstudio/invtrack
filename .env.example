# --- Database -------------------------------------------------------------
# Supabase (production): use the Session pooler connection string from
# Supabase Dashboard -> Project Settings -> Database, with the psycopg driver:
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development: leave unset to use a SQLite file (backend/invtrack.db).
#DATABASE_URL=postgresql+psycopg://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- SEC EDGAR ------------------------------------------------------------
# The SEC asks automated clients to identify themselves. Use your name/app
# and a real contact email.
SEC_EDGAR_USER_AGENT="invtrack personal research you@example.com"

# --- Congressional trade datasets ------------------------------------------
# The community Stock Watcher buckets occasionally move or go offline. If a
# chamber's ingest starts failing (e.g. 403), point these at a working mirror.
#SENATE_DATA_URL=https://senate-stock-watcher-data.s3-us-west-2.amazonaws.com/aggregate/all_transactions.json
#HOUSE_DATA_URL=https://house-stock-watcher-data.s3-us-west-2.amazonaws.com/data/all_transactions.json

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API (the Vite dev server by default).
#CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
